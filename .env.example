# Supabase Postgres connection string used by Prisma (see prisma.config.ts).
# Copy this file to .env and fill in real values from your Supabase project settings
# (Dashboard -> Connect -> Direct tab -> Session pooler).
# Format: postgresql://<user>.<project-ref>:<password>@<host>:5432/postgres?schema=public
#
# Use the SESSION POOLER string (port 5432 via pooler.supabase.com), not the
# Transaction pooler (port 6543) or the true Direct connection (db.<ref>.supabase.co).
# - The true Direct connection needs IPv6 and is often unreachable without the paid
#   IPv4 add-on.
# - The Transaction pooler is IPv4-compatible but doesn't support the session-level
#   operations `prisma migrate`/`prisma db pull` need (fails with P1017).
# - Session pooler is IPv4-compatible AND supports both migrations and normal app
#   queries, so it works as the single DATABASE_URL. Prisma 7 removed the
#   `directUrl` split, so there's no way to use two different connection strings
#   for CLI commands vs. the app runtime -- one string has to do both.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"

# Groq API key for the Query Assistant (Story 5.2) -- free tier, used for
# openai/gpt-oss-120b tool-calling. Get one at https://console.groq.com/keys.
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# YouTrack REST connection (Backlog pull / Sprint close). No longer DB-backed
# (was YouTrackConfig) -- set these directly and redeploy to change them.
YOUTRACK_INSTANCE_URL="https://your-instance.example.com"
YOUTRACK_PROJECT_ID="DEMO"
YOUTRACK_AUTH_TOKEN="perm:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# YouTrack MCP connection for the Query Assistant (Story 5.1/5.2). No longer
# DB-backed (was YouTrackMcpConfig) -- set these directly and redeploy to change them.
YOUTRACK_MCP_SERVER_URL="https://your-instance.example.com/mcp"
YOUTRACK_MCP_PROJECT_ID="DEMO"
YOUTRACK_MCP_AUTH_TOKEN="perm:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TeamMember {
  id                 String    @id @default(cuid())
  name               String
  workingHoursPerDay Int
  archivedAt         DateTime?
  allocations        TeamMemberAllocation[]
  leaves             Leave[]
  backlogIssues      BacklogIssue[]
}

model AllocationCategory {
  id          String  @id @default(cuid())
  name        String
  isDev       Boolean @default(false)

  // At most one category may be the Dev one -- DB-level backstop is a
  // hand-added partial unique index (Prisma's schema DSL has no
  // partial/filtered @@unique syntax), mirroring Sprint's
  // Sprint_one_active_idx pattern. See migration
  // add_allocation_category_is_dev/migration.sql. Existing rows backfilled
  // to isDev=false via the column default -- no category is auto-selected,
  // a human marks one afterward.
  allocations TeamMemberAllocation[]
}

enum SprintStatus {
  active
  closed
}

model Sprint {
  id        String       @id @default(cuid())
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SprintStatus @default(active)

  // Nullable until Close Sprint (Story 4.2) populates them. Float (not Int,
  // Story 4.2's own fix to the original scaffolding) -- matches every other
  // hours figure in this schema (BacklogIssue.estimateHours/loggedHours,
  // computeCapacityForTeam's output), all fractional-hours-precision.
  snapshotCapacityHours       Float?
  snapshotAllocationBreakdown Json?
  snapshotActualVelocityHours Float?

  // AD-6's DB-level backstop (partial unique index on status = 'active') is
  // hand-added to this model's migration SQL -- Prisma's schema DSL has no
  // partial/filtered @@unique syntax. See migration
  // add_sprint/migration.sql.

  backlogIssues BacklogIssue[]
}

enum LeaveType {
  planned
  emergency
}

model Leave {
  id           String    @id @default(cuid())
  teamMemberId String
  type         LeaveType
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date

  // No sprintId -- a Leave entry isn't tied to one Sprint by reference,
  // matching Holiday's same pattern in the ERD. Both are evaluated against
  // whichever Sprint's range they overlap at Capacity-computation time
  // (Story 2.5).
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([teamMemberId])
}

model Holiday {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // No teamMemberId, no sprintId -- company-wide, evaluated against
  // whichever Sprint's range it overlaps at Capacity-computation time
  // (Story 2.5), same as Leave.
}

model ShareToken {
  id    String @id @default(cuid())
  token String

  // Singleton via a fixed, hardcoded id ("singleton") as the primary key --
  // exactly one standing app-level token (AD-4), never one per Sprint. Generated
  // lazily (crypto.randomUUID(), infrastructure/db/share-token-repository.ts)
  // the first time anyone reads it, never regenerated once it exists.
}

model TeamMemberAllocation {
  id           String @id @default(cuid())
  teamMemberId String
  categoryId   String
  percent      Int

  // onDelete: Restrict is a hard DB-level backstop for the app-level
  // isCategoryInUse guard in removeAllocationCategory -- closes the TOCTOU
  // race where a concurrent allocation-save could create a reference
  // between the check and the delete.
  teamMember TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  category   AllocationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([teamMemberId, categoryId])
  @@index([categoryId])
}

model BacklogIssue {
  id                  String    @id @default(cuid())
  youtrackIssueId     String
  sprintId            String
  title               String
  assigneeId          String?
  estimateHours       Float
  loggedHours         Float     @default(0)
  loggedHoursPulledAt DateTime?

  // No assignee at pull time -- Story 3.3's own decision, contrary to the
  // Architecture Spine ERD's unannotated (implied non-null) assigneeId.
  // Story 3.4 is the only place an assignee gets set; onDelete: SetNull
  // matches this being an optional relation (TeamMember is soft-deleted in
  // practice, so this rarely fires, but SetNull is the correct semantic
  // default for a nullable FK regardless).
  sprint   Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  assignee TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // DB-level backstop against double-pulling the same YouTrack issue into
  // the same Sprint -- same two-layer (app pre-check + DB constraint)
  // pattern as AD-6's Sprint_one_active_idx / Story 1.7's createSprint.
  // estimateHours also has a hand-added CHECK constraint (> 0) mirroring
  // Leave/Holiday's endDate-check pattern -- see migration
  // add_backlog_issue_constraints/migration.sql (Prisma's schema DSL has no
  // CHECK-constraint syntax).
  @@unique([sprintId, youtrackIssueId])
  @@index([sprintId])
  @@index([assigneeId])
}

model AppPassword {
  id   String @id
  hash String

  // Singleton (id "singleton"), same fixed-PK convention as ShareToken. The
  // single app-wide login password, stored as "<salt>:<scrypt hash>" hex --
  // never plaintext. Set/rotate with scripts/set-password.mjs (lib/auth.ts
  // verifies it).
}
